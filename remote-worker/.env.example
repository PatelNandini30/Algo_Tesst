# Copy to .env, fill in NODE_IP below, then `docker compose up -d`
# (no --build needed — the image is loaded from algotest-worker-image.tar).

# --- Main box (the PC running the actual webapp/backend/postgres/redis) ---
# This is already this box's real LAN IP — only change it if that changes.
MAIN_BOX_IP=192.168.4.34
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
POSTGRES_DB=algotest
POSTGRES_USER=algotest
POSTGRES_PASSWORD=algotest_password

# --- This PC (the remote worker) ---
# Find this PC's own LAN IP with: hostname -I  (or `ip addr`)
NODE_IP=192.168.4.23
# How many of THIS PC's cores to dedicate. Matches the "Core:" picker in the
# webapp's navbar once this node shows up there.
NODE_CONCURRENCY=2
NODE_CPU_LIMIT=4.0
# In-job fork parallelism for optimize sweeps run on this node (separate from
# NODE_CONCURRENCY, which is how many jobs this node runs AT ONCE).
NODE_OPTIMIZE_PARALLELISM=2
# Hard memory ceiling for the container. Leave headroom for this PC's OS/apps.
NODE_MEMORY_LIMIT_MB=8000
# Optional: override this PC's reported RAM (MB) if auto-detection via
# /proc/meminfo is wrong inside the container. 0 = auto-detect.
NODE_RAM_MB=0
# Port this PC serves its own job downloads (tradesheets ZIP / WOW-MOM / summary)
# on. The browser hits http://<NODE_IP>:<this port> directly, so this PC's
# FIREWALL must allow the office LAN to reach it. KEEP THIS 8100 unless you also
# change NODE_API_PORT on the main box (it assumes 8100 when building the link).
NODE_API_PORT=8100
