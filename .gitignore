.deps_build_hash
.rust_wheel_hash
backend/prebuilt/
.graphify_detect.json
.graphify_python
graphify-out/
.codex/
cleaned_csvs/
**/__pycache__/
**/*.pyc
.venv/
.worktrees/
.~lock.*
*.docx~
node_modules/
backend/native/target/
# Compiled native extension — built by start.sh into a wheel (backend/prebuilt)
# and installed into site-packages. Never commit the .so: a tracked copy in
# backend/ shadows the wheel via the bind-mount and pins an old Rust build.
backend/algotest_native*.so
frontend/dist/
.claude/
nifty_data/
git-credential-manager/
# remote-worker/ image export — a large binary artifact regenerated per code
# update via `docker save`, not source. Never commit it.
remote-worker/*.tar
remote-worker/.env

# Persisted ./start.sh --optimize preference (local, per-box)
.start-optimize

# --- Generated / non-source artifacts: NEVER commit (they broke pushes: a
# 4.4 GB zip in downloads/ exceeded GitHub's 100 MB blob limit → HTTP 500). ---
# Optimizer/backtest output ZIPs, xlsx and data dumps (multi-GB).
downloads/
# AI assistant transcripts — notes, not source.
claude_conversation/
codex-session-*.md
codex_conversation/
# Runtime logs.
*.log
# Local scratch / debug scripts and backups.
backend/gop*.py
backend/ovdbg*.py
*.bak_*
ai-skills-pack-main/

# Environment files: keep local configuration out of Git.
.env
.env.*
!.env.example

# Common local/generated artifacts.
.DS_Store
Thumbs.db
*.tmp
*.temp
# Repository cleanup: raw exports and generated validation outputs.
NFO_PREPARED/
backend/prebuilt-next/
/backend/*.xlsx
/backend/_*.json
/csv_schema_discovery_report.json
/csv_schema_discovery_report.md
*.db
*.sqlite
*.sqlite3
*.parquet
*.feather
*.arrow
# Deliberate test fixtures remain eligible for tracking.
!backend/tests/fixtures/**/*.db
!backend/tests/fixtures/**/*.sqlite
!backend/tests/fixtures/**/*.sqlite3
!backend/tests/fixtures/**/*.parquet
!backend/tests/fixtures/**/*.feather
!backend/tests/fixtures/**/*.arrow
# frontend/build remains tracked while Dockerfile requires COPY build.
